# Kalshi API Configuration
#
# CREDENTIALS: Auto-discovered from credential directories (preferred)
#
#   api-demo-key/       <- Demo environment credentials
#     api-key-id.txt    <- Contains your demo API key ID
#     *.pem             <- Your demo RSA private key file
#
#   api-prod-key/       <- Production environment credentials
#     api-key-id.txt    <- Contains your prod API key ID
#     *.pem             <- Your prod RSA private key file
#
# Or set explicit env vars below (overrides auto-discovery):
# KALSHI_API_KEY_ID=your-key-id-here
# KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Environment: demo or prod (default: demo)
# Can also be set via CLI: python -m dashboard.backend.main --env prod
# demo = https://demo-api.kalshi.co (fake money, for testing)
# prod = https://api.elections.kalshi.com (real money)
KALSHI_ENV=demo
