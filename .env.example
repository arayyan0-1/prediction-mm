# Kalshi API Configuration
# Copy this file to .env and fill in your credentials

# Your API Key ID from Kalshi (Account Settings > API Keys)
KALSHI_API_KEY_ID=your-key-id-here

# Path to your RSA private key file (.pem format)
# Downloaded when you create an API key on Kalshi
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Environment: demo or prod
# demo = https://demo-api.kalshi.co (fake money, for testing)
# prod = https://api.elections.kalshi.com (real money)
KALSHI_ENV=demo
